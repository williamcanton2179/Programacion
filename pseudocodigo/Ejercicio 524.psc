Proceso Ej524
	
	Definir i Como Entero
	Definir detener Como Logico
	
	detener <- Falso
	
	Para i <- 1 Hasta 10 Hacer
		
		Si detener = Falso Entonces
			
			Si i = 5 Entonces
				Escribir "Se encontro el 5, se detiene el ciclo."
				detener <- Verdadero
			SiNo
				Escribir i
			FinSi
			
		FinSi
		
	FinPara
	
FinProceso